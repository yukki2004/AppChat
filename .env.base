# Giá trị chung, KHÔNG nhạy cảm, giống nhau ở mọi môi trường.
# Password/secret thật KHÔNG đặt ở đây — xem .env.dev (local) hoặc secret manager (stg/prod).

# ---- Postgres (1 container, nhiều database) ----
# Port host-side 5433 (không phải 5432 mặc định) vì máy dev đã có sẵn 1 Postgres/Timescale khác
# đang chiếm 5432 — không đụng tới container đó, chỉ đổi port container của ChatApp.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_SUPERUSER=postgres

CORE_DB_NAME=core_db
CORE_DB_USER=core_user

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user

CALL_DB_NAME=call_db
CALL_DB_USER=call_user

SOCIAL_DB_NAME=social_db
SOCIAL_DB_USER=social_user

# ---- MongoDB (1 container, nhiều database) ----
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_SUPERUSER=root

MESSAGING_MONGO_DB_NAME=messaging_db
MESSAGING_MONGO_USER=messaging_user

MEDIA_MONGO_DB_NAME=media_db
MEDIA_MONGO_USER=media_user

SOCIAL_MONGO_DB_NAME=social_db
SOCIAL_MONGO_USER=social_user

# ---- Redis (1 container dùng chung toàn hệ thống) ----
# Port 6380 (không phải 6379 mặc định) — máy dev đã có sẵn 1 Redis khác đang chiếm 6379.
REDIS_HOST=localhost
REDIS_PORT=6380

# ---- RabbitMQ (1 container, 8 exchange pre-declare) ----
# Port 5673/15673 (không phải 5672/15672 mặc định) — máy dev đã có sẵn 1 RabbitMQ khác đang
# chiếm 2 port đó.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
