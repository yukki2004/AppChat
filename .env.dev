# Override cho môi trường dev/local. Password yếu cố định — CHỈ chấp nhận được vì chạy local,
# không bao giờ dùng lại các giá trị này cho stg/prod.

APP_ENV=dev
LOG_LEVEL=DEBUG

POSTGRES_SUPERUSER_PASSWORD=postgres_dev_pw
CORE_DB_PASSWORD=core_dev_pw
NOTIFICATION_DB_PASSWORD=notification_dev_pw
CALL_DB_PASSWORD=call_dev_pw
SOCIAL_DB_PASSWORD=social_dev_pw

MONGO_SUPERUSER_PASSWORD=mongo_dev_pw
MESSAGING_MONGO_PASSWORD=messaging_dev_pw
MEDIA_MONGO_PASSWORD=media_dev_pw
SOCIAL_MONGO_PASSWORD=social_dev_pw

RABBITMQ_DEFAULT_USER=chatapp_dev
RABBITMQ_DEFAULT_PASS=rabbitmq_dev_pw

# Core Service — 2FA (login/2fa/challenge). Gmail App Password required (not your normal Gmail
# password) — Google Account → Security → 2-Step Verification → App passwords. Leave blank to
# skip testing the EMAIL 2FA method locally (SMS not implemented yet, TOTP needs no mail creds).
MAIL_USERNAME=
MAIL_PASSWORD=
OTP_MAIL_FROM=no-reply@chatapp.local
# Fixed dev-only key so restarts don't invalidate existing totp_secret_enc rows. Generate a
# fresh one for stg/prod: `openssl rand -base64 32` — NEVER reuse this dev value elsewhere.
TOTP_SECRET_ENCRYPTION_KEY=b4oq0uZHF/IGHvaJF1xoKjBX/KX/3/eyz3SZvzvJ46I=
