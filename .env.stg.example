# Template — liệt kê field cần có cho môi trường staging.
# File .env.stg THẬT không commit vào git — giá trị thật lấy từ secret manager/CI secrets lúc deploy.

APP_ENV=stg
LOG_LEVEL=INFO

POSTGRES_SUPERUSER_PASSWORD=__set_via_secret_manager__
CORE_DB_PASSWORD=__set_via_secret_manager__
NOTIFICATION_DB_PASSWORD=__set_via_secret_manager__
CALL_DB_PASSWORD=__set_via_secret_manager__
SOCIAL_DB_PASSWORD=__set_via_secret_manager__

MONGO_SUPERUSER_PASSWORD=__set_via_secret_manager__
MESSAGING_MONGO_PASSWORD=__set_via_secret_manager__
MEDIA_MONGO_PASSWORD=__set_via_secret_manager__
SOCIAL_MONGO_PASSWORD=__set_via_secret_manager__

RABBITMQ_DEFAULT_USER=__set_via_secret_manager__
RABBITMQ_DEFAULT_PASS=__set_via_secret_manager__
