# Secret thật theo môi trường — chỉ giữ lại .example làm template
.env.dev.local
.env.stg
.env.prod
# File .env gộp tự sinh bởi scripts/dev-up.sh (.env.base + .env.dev), không phải nguồn thật
.env

# Build output
target/
*.class
bin/
obj/
services/*/bin/
services/*/obj/

# Go
services/*/vendor/
*.exe
*.exe~

# Log file phát sinh lúc chạy local
*.log

# RSA key tự gen lúc dev (JwtKeyManager) — không bao giờ commit private key
services/*/keys/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db
